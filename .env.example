LEISURELOG_DATABASE_URL=sqlite:///./data/leisurelog.db
LEISURELOG_ACTIVITYWATCH_URL=http://127.0.0.1:5600
LEISURELOG_RULES_PATH=config/rules.yaml
LEISURELOG_PLAYNITE_EXPORT_PATH=data/playnite-library.json
LEISURELOG_PLAYNITE_BINDINGS_PATH=config/playnite-processes.yaml
LEISURELOG_SESSION_GAP_SECONDS=60
LEISURELOG_AUTO_SYNC_ENABLED=true
LEISURELOG_AUTO_SYNC_INTERVAL_SECONDS=60
LEISURELOG_AUTO_SYNC_OVERLAP_SECONDS=600
LEISURELOG_AUTO_SYNC_INITIAL_HOURS=24

# Backups run independently of sync; 0 days disables automatic backups.
LEISURELOG_AUTO_BACKUP_DAYS=7
LEISURELOG_AUTO_BACKUP_KEEP=4
LEISURELOG_AUTO_BACKUP_CHECK_SECONDS=3600

# Optional; default is a backups directory beside the SQLite database.
# LEISURELOG_BACKUP_DIR=D:/LeisureLogBackups

# Optional explicit browser bucket -> device mapping for multiple computers.
# LEISURELOG_BROWSER_DEVICE_BINDINGS={"aw-watcher-web-chrome":"YOUR_HOSTNAME"}
